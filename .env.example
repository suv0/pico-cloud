# Optional overrides for Docker Compose (copy to .env in repo root).
# Works without this file: defaults are PORT=3080 and a demo SESSION_SECRET in compose.
#
# PORT=3090
# SESSION_SECRET=your-own-secret-at-least-32-chars
#
# --- npm run dev (local Next.js against Docker Postgres on host port 5433) ---

DATABASE_URL="postgresql://pico:pico@localhost:5433/pico"
SESSION_SECRET="change-me-to-a-32-char-minimum-secret-key"
NODE_ENV="development"
PORT="3080"
